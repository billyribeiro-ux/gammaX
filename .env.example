# ───────────────────────────────────────────────────────────────────────────
# gammaX — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────────────────

# ── Feed selection ─────────────────────────────────────────────────────────
# 'schwab' = live read-only market data; 'replay' = re-emit recorded snapshots;
# 'synthetic' = deterministic generated chains (no external deps, CI-friendly).
FEED_SOURCE=synthetic

# ── Schwab Trader API (READ-ONLY market data; no trading scopes, ever) ───────
# Create an app at https://developer.schwab.com — request Market Data only.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# OAuth callback registered on the Schwab app (must match exactly).
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182/callback
# Path to the gitignored token file holding access+refresh tokens.
SCHWAB_TOKEN_FILE=./.schwab-tokens.json
# Streamer quality-of-service: 0=Express(500ms) 1=RealTime(750) 2=Fast(1000) ...
SCHWAB_STREAM_QOS=0

# ── Database (recorder) ─────────────────────────────────────────────────────
# 'postgres' (default) or 'sqlite'.
DB_DRIVER=postgres
# Postgres profile:
DATABASE_URL=postgres://gammax:gammax@localhost:5432/gammax
# SQLite profile (used when DB_DRIVER=sqlite):
SQLITE_PATH=./data/gammax.sqlite

# ── Engine ──────────────────────────────────────────────────────────────────
# WebSocket server the dashboard subscribes to.
ENGINE_WS_PORT=8787
# Recompute throttle (ms) — independent of the 500ms feed QoS.
ENGINE_RECOMPUTE_MS=1500
# Underlyings to track (comma-separated). Phase 1 = S&P only.
ENGINE_UNDERLYINGS=SPX,SPY
# Forward-grading horizons in minutes (comma-separated).
ENGINE_GRADE_HORIZONS=15,30,60
# Regular trading hours window (ET, 24h). DST handled via temporal-polyfill.
ENGINE_RTH_OPEN=09:30
ENGINE_RTH_CLOSE=16:00

# ── Risk params (BS model inputs) ───────────────────────────────────────────
# Risk-free rate (SOFR-based, annualized decimal) and dividend yields.
RISK_FREE_RATE=0.043
SPX_DIVIDEND_YIELD=0.0
SPY_DIVIDEND_YIELD=0.012

# ── IV-velocity thresholds ──────────────────────────────────────────────────
IV_ZSCORE_THRESHOLD=2.0
IV_ROLLING_WINDOW=90

# ── Dashboard ───────────────────────────────────────────────────────────────
# Public URL the browser uses to reach the engine WS.
PUBLIC_ENGINE_WS_URL=ws://localhost:8787
