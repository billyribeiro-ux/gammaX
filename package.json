{
	"name": "gammax",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "S&P 0DTE gamma-exposure + IV-velocity research engine (Phase 1, forward-only)",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24.17.0"
	},
	"scripts": {
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint . && pnpm --filter @gammax/web lint",
		"test": "pnpm -r test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
		"engine:dev": "pnpm --filter @gammax/engine dev",
		"web:dev": "pnpm --filter @gammax/web dev",
		"dev:all": "pnpm --parallel --filter @gammax/engine --filter @gammax/web run dev"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.5.0",
		"globals": "17.6.0",
		"prettier": "3.8.4",
		"prettier-plugin-svelte": "4.1.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.0"
	}
}
