{
	"name": "@gammax/engine",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "DB_DRIVER=${DB_DRIVER:-sqlite} SQLITE_PATH=${SQLITE_PATH:-.gammax-dev.sqlite} FEED_SOURCE=${FEED_SOURCE:-synthetic} ENGINE_SESSION_AWARE=${ENGINE_SESSION_AWARE:-false} tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@gammax/contracts": "workspace:*",
		"@gammax/core": "workspace:*",
		"@gammax/recorder": "workspace:*",
		"@gammax/replay": "workspace:*",
		"@gammax/schwab": "workspace:*",
		"temporal-polyfill": "catalog:",
		"ws": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/ws": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
